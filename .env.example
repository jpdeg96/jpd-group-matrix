# ---------------------------------------------------------------------------
# PhantomChecker Events — environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Used by Prisma for both migrations and runtime.
# Local docker-compose default:
DATABASE_URL="postgresql://phantom:phantom@localhost:5432/phantomchecker?schema=public"

# Connection used for migrations. REQUIRED — Prisma refuses to load the schema
# if a referenced environment variable is missing, so this must always be set.
# Providers that put a connection pooler in front of Postgres (Neon, Supabase)
# give you a separate direct endpoint; use it here. For a plain local Postgres
# there is no pooler, so just repeat DATABASE_URL.
DIRECT_URL="postgresql://phantom:phantom@localhost:5432/phantomchecker?schema=public"

# Scratch database used by `npm run test:integration`. That suite TRUNCATES
# tables, so point it at a throwaway database — never the one you develop
# against. If unset, the integration suite falls back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://phantom:phantom@localhost:5432/phantomchecker_test?schema=public"


# --- Authentication ---------------------------------------------------------
# Required. Signs the session JWT. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment. Required in production; optional locally.
AUTH_URL="http://localhost:3000"

# Set to true behind a reverse proxy / on Vercel so cookies and callback URLs
# resolve against the forwarded host.
AUTH_TRUST_HOST="true"

# --- Optional: Google OAuth -------------------------------------------------
# Leave BOTH blank to disable the "Sign in with Google" button. When enabled,
# a Google account may only sign in if a matching ACTIVE user row already
# exists (matched on email). Google sign-in never self-registers new users.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""


# --- Maintenance scheduler --------------------------------------------------
# Shared secret protecting POST /api/internal/maintenance from public
# invocation. Required in production. Generate with: openssl rand -hex 32
# Callers must send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-me-with-a-long-random-string"

# Base URL the standalone scheduler (scripts/scheduler.ts) posts to.
MAINTENANCE_URL="http://localhost:3000/api/internal/maintenance"

# Cron expression + timezone used ONLY by scripts/scheduler.ts (self-hosting).
# Vercel Cron is configured separately in vercel.json and is UTC-only.
MAINTENANCE_CRON="5 6 * * *"
MAINTENANCE_CRON_TIMEZONE="America/Chicago"


# --- Clockify (optional) ----------------------------------------------------
# Personal API key from Clockify → Profile settings → API.
#
# Deliberately an environment variable rather than a Settings field, so a
# database dump never contains a live credential and the browser never receives
# one. The workspace id is NOT secret and is configured in Settings → Clockify.
# Leave blank to disable the time widget entirely.
# CLOCKIFY_API_KEY=""


# --- Seeding ----------------------------------------------------------------
# Password assigned to every seeded demo user. Development only.
SEED_PASSWORD="phantom1234"
