// JPD Group Matrix — database schema
//
// Lifecycle of an event:
//
//   Event Dashboard  →  (Complete ticked)  →  C1 staging  →  archived
//
// In C1 an event is a single row showing its *current* review stage. Ticking
// Done advances it to the next stage (D-21 → D-14 → D-7 → D-5 → D-1) with a
// freshly calculated Review Due. When the last stage is done the event leaves
// C1 entirely.
//
// All five stage rows are created up front so the completion history survives
// for productivity reporting, even though only one is ever displayed.
//
// Date semantics:
//   - `event_date` and `review_due` are calendar DATEs. No time, no zone. All
//     arithmetic happens in application code against the configured business
//     timezone (see lib/date/plain-date.ts).
//   - Every other time column is a true instant stored as TIMESTAMPTZ (UTC) and
//     rendered to the user in the business timezone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  USER

  @@map("user_role")
}

enum EventStatus {
  /// On the Event Dashboard, not yet sent to staging.
  DASHBOARD
  /// In C1 staging, working through its review stages.
  C1
  /// All review stages resolved. Hidden from the UI, retained for reporting.
  COMPLETED
  /// Withdrawn. History kept.
  CANCELLED

  @@map("event_status")
}

enum StageStatus {
  /// Awaiting review.
  PENDING
  /// Reviewed and ticked off.
  DONE
  /// Its due date had already passed when the event reached C1, so it was
  /// never actionable. Distinguished from DONE so reporting is not misleading.
  SKIPPED

  @@map("stage_status")
}

/// Where a user is currently working. Scoped so presence on the dashboard and
/// in C1 are shown independently.
enum PresenceContext {
  DASHBOARD
  C1

  @@map("presence_context")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  /// bcrypt hash. NULL means this account can only sign in via Google.
  passwordHash String?  @map("password_hash")
  /// Superseded by `roleId`. Kept populated in step with it so a rollback to
  /// the previous release still finds a usable value; nothing reads it.
  role         UserRole @default(USER)
  roleId       String?  @map("role_id") @db.Uuid
  roleRef      Role?    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  active Boolean @default(true)

  /// Identity color, `#rrggbb`. Used for the dot beside their name in every
  /// dropdown, assignment cell and presence indicator.
  color String @default("#64748b")

  /// This person's own theme choice. NULL means "follow the site default".
  /// Stored per user rather than only in localStorage so the choice follows
  /// them between machines.
  theme String? @db.VarChar(16)

  /// Their Clockify user id, so time entries can be attributed. NULL when they
  /// are not linked to Clockify.
  clockifyUserId String? @map("clockify_user_id")

  /// Keeps this person out of the hours-worked comparison on the Metrics page.
  /// Intended for owners and administrators whose hours are not comparable to
  /// operational staff and would distort the chart. A toggle rather than a
  /// hard-coded name, so who is excluded can change without a code change.
  excludeFromTimeReport Boolean @default(false) @map("exclude_from_time_report")

  /// Lets this person press Start on an event that is already ticked Complete.
  ///
  /// Off by default, because starting work on something recorded as finished is
  /// almost always a mis-click — the honest move is to untick Complete first,
  /// which is exactly the correction the stale filter exists to surface. It is
  /// a per-person override rather than a global setting so the exception can be
  /// granted to whoever genuinely needs it without loosening the rule for
  /// everybody.
  canStartCompleted Boolean @default(false) @map("can_start_completed")

  /// Superseded by `pushMuted`. Kept populated in step with it so a rollback to
  /// the previous release still finds a usable value; nothing reads it.
  pushClockEvents Boolean @default(true) @map("push_clock_events")

  /// Which kinds of notification this person does NOT want on their devices.
  ///
  /// The muted set rather than the enabled one, so a category added later is on
  /// by default for everybody instead of starting silently off — which looks
  /// exactly like the feature being broken. Empty means everything.
  ///
  /// Separate from permissions, which decide whether somebody may be told at
  /// all. The permission is a manager's call about a role; this is the person's
  /// own call about their phone. Muting never suppresses the bell, only the
  /// push.
  pushMuted String[] @default([]) @map("push_muted")

  pushSubscriptions PushSubscription[]
  clockStatus       ClockStatus?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedEvents      Event[]        @relation("EventAssignee")
  completedEvents     Event[]        @relation("EventCompletedBy")
  seatGeekChecks      Event[]        @relation("EventSeatGeekBy")
  ticketDataChecks    Event[]        @relation("EventTicketDataBy")
  auditedEvents       Event[]        @relation("EventAuditedBy")
  flaggedEvents       Event[]        @relation("EventFlaggedBy")
  resolvedFlags       Event[]        @relation("EventFlagResolvedBy")
  fixedFlags          Event[]        @relation("EventFlagFixedBy")
  notifications       Notification[] @relation("NotificationRecipient")
  causedNotifications Notification[] @relation("NotificationActor")
  assignedStages      ReviewStage[]  @relation("StageAssignee")
  completedStages     ReviewStage[]  @relation("StageDoneBy")
  notes               EventNote[]
  presence            Presence[]
  auditLogs           AuditLog[]

  /// Payroll. A user may be the person behind a contractor record, and may be
  /// the manager who signs weeks off — separate relations, since they are
  /// rarely the same person and must never be conflated.
  contractor      Contractor?      @relation("ContractorUser")
  approvedPayroll WeeklyApproval[] @relation("ApprovalApprover")

  @@index([active, displayName])
  @@map("users")
}

/// A role, and the permissions granted to it.
///
/// Roles used to be the `UserRole` enum and permissions were a rank comparison
/// in code, which meant every question was "is this person senior enough?" —
/// unanswerable for "a manager who may not see payroll". Roles are rows now and
/// permissions are named capabilities, so a role is whatever set somebody chose.
///
/// The *catalogue* of permissions stays in code (`lib/domain/permissions.ts`).
/// A permission only exists if something enforces it, so a row naming one the
/// code does not know about would be a switch wired to nothing; unknown keys are
/// ignored on read and refused on write.
model Role {
  id  String @id @default(uuid()) @db.Uuid
  /// Stable identifier, uppercase. Never changes once created — audit entries
  /// and the three built-ins are keyed on it.
  key String @unique

  name        String
  description String?

  /// ADMIN, MANAGER and USER. Their grants are editable like any other role,
  /// but they cannot be deleted: every user points at one, and ADMIN is what
  /// the lock-out guard stands on.
  isSystem  Boolean @default(false) @map("is_system")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       User[]

  @@index([sortOrder, name])
  @@map("roles")
}

/// One granted capability. Absence is denial — there is no "deny" row, because
/// two ways to say no is one more than necessary.
model RolePermission {
  id     String @id @default(uuid()) @db.Uuid
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// A key from the catalogue in code.
  permission String

  @@unique([roleId, permission], map: "role_permissions_role_permission_key")
  @@index([roleId])
  @@map("role_permissions")
}

/// Administrator-managed list of event types (formerly "leagues").
model EventType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// Optional emoji shown beside the type, so rows are scannable by shape as
  /// well as by reading. Never the only cue — the name is always present.
  emoji     String?  @db.VarChar(8)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@index([active, sortOrder, name])
  @@map("event_types")
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  /// Calendar date of the event itself. DATE, not a timestamp.
  eventDate DateTime @map("event_date") @db.Date

  eventTypeId String    @map("event_type_id") @db.Uuid
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  /// Away team, or the performing artist for non-team events.
  awayTeam String? @map("away_team")
  homeTeam String? @map("home_team")
  venue    String?

  status EventStatus @default(DASHBOARD)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Ticking Complete is what promotes the event into C1.
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  completedById String?   @map("completed_by_id") @db.Uuid
  completedBy   User?     @relation("EventCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  seatGeekCheckedAt DateTime? @map("seatgeek_checked_at") @db.Timestamptz(6)
  seatGeekById      String?   @map("seatgeek_by_id") @db.Uuid
  seatGeekBy        User?     @relation("EventSeatGeekBy", fields: [seatGeekById], references: [id], onDelete: SetNull)

  /// TicketData is a plain flag — no timestamp is recorded, by request.
  ticketDataChecked Boolean @default(false) @map("ticketdata_checked")
  ticketDataById    String? @map("ticketdata_by_id") @db.Uuid
  ticketDataBy      User?   @relation("EventTicketDataBy", fields: [ticketDataById], references: [id], onDelete: SetNull)

  /// Final audit pass on the dashboard row.
  auditedAt   DateTime? @map("audited_at") @db.Timestamptz(6)
  auditedById String?   @map("audited_by_id") @db.Uuid
  auditedBy   User?     @relation("EventAuditedBy", fields: [auditedById], references: [id], onDelete: SetNull)

  /// Raised by anyone who needs a manager or administrator to look at this.
  /// Cleared by resolving, which keeps who raised it and who cleared it.
  flaggedAt        DateTime? @map("flagged_at") @db.Timestamptz(6)
  flaggedById      String?   @map("flagged_by_id") @db.Uuid
  flaggedBy        User?     @relation("EventFlaggedBy", fields: [flaggedById], references: [id], onDelete: SetNull)
  flagReason       String?   @map("flag_reason")
  flagResolvedAt   DateTime? @map("flag_resolved_at") @db.Timestamptz(6)
  flagResolvedById String?   @map("flag_resolved_by_id") @db.Uuid
  flagResolvedBy   User?     @relation("EventFlagResolvedBy", fields: [flagResolvedById], references: [id], onDelete: SetNull)

  /// "I have dealt with this" — set by whoever the flag was for, and cleared
  /// only when a manager confirms. Deliberately distinct from
  /// `flagResolvedAt`: the person who fixes the problem is not the person who
  /// signs it off, and collapsing the two would let a flag be closed by the
  /// account that caused it. The flag stays raised and visible until a manager
  /// clears it; this only says it is ready to be checked.
  flagFixedAt   DateTime? @map("flag_fixed_at") @db.Timestamptz(6)
  flagFixedById String?   @map("flag_fixed_by_id") @db.Uuid
  flagFixedBy   User?     @relation("EventFlagFixedBy", fields: [flagFixedById], references: [id], onDelete: SetNull)

  promotedAt  DateTime? @map("promoted_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  /// Set once the event date has passed. Archived events disappear from both
  /// the Dashboard and C1 but keep every note, stage and completion record —
  /// that history is the productivity data, and deleting the row would take it
  /// with them. Deliberately a timestamp rather than a status, so an archived
  /// event still remembers whether it reached C1.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  /// Where this event came from, when it was not created in this application.
  ///
  /// Set by the one-time migration off the PhantomChecker spreadsheet. Legacy
  /// rows are genuinely thinner than native ones — the spreadsheet recorded no
  /// assignee, nobody against a completion, and no author on a note — so this
  /// exists to explain the difference rather than let it look like data loss.
  /// Null means the event was created here.
  legacySource String? @map("legacy_source")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Deleting an event removes its C1 presence and stage history with it.
  stages        ReviewStage[]
  notes         EventNote[]
  presence      Presence[]
  notifications Notification[]

  @@index([status, eventDate], map: "events_status_event_date_idx")
  @@index([eventDate], map: "events_event_date_idx")
  @@index([assigneeId], map: "events_assignee_idx")
  @@index([eventTypeId], map: "events_event_type_idx")
  @@index([flaggedAt], map: "events_flagged_idx")
  @@index([archivedAt, eventDate], map: "events_archived_idx")
  @@map("events")
}

/// One review checkpoint. Five per event; C1 displays only the current one.
model ReviewStage {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Permanent stage metadata — 21, 14, 7, 5, 1 by default, but the set is
  /// administrator-configurable in Settings. The "D-21" label derives from
  /// this, never from review_due, which weekend adjustment makes ambiguous.
  offsetDays Int @map("offset_days") @db.SmallInt

  /// Effective (weekend-adjusted) due date. Overridable by hand.
  reviewDue           DateTime @map("review_due") @db.Date
  /// True once someone has edited the date, so recalculation leaves it alone.
  reviewDueOverridden Boolean  @default(false) @map("review_due_overridden")

  status StageStatus @default(PENDING)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("StageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  doneAt   DateTime? @map("done_at") @db.Timestamptz(6)
  doneById String?   @map("done_by_id") @db.Uuid
  doneBy   User?     @relation("StageDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Idempotency key for promotion. Deliberately NOT (event_id, review_due):
  /// weekend adjustment can collapse two stages onto one date and both must
  /// survive.
  @@unique([eventId, offsetDays], map: "review_stages_event_offset_key")
  @@index([status, reviewDue], map: "review_stages_status_due_idx")
  @@index([eventId], map: "review_stages_event_idx")
  @@index([assigneeId], map: "review_stages_assignee_idx")
  @@map("review_stages")
}

/// An append-only note. Several people leave notes on the same event, so each
/// one carries its own author and timestamp rather than sharing a text field.
model EventNote {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body String

  /// Set when edited by its author; the original text is kept in the audit log.
  editedAt DateTime? @map("edited_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId, createdAt(sort: Desc)], map: "event_notes_event_idx")
  @@map("event_notes")
}

/// Why somebody is being told about something.
enum NotificationKind {
  /// A flag was raised on an event this person is accountable for.
  FLAG_RAISED
  /// Whoever the flag was for says they have dealt with it; a manager should check.
  FLAG_FIXED
  /// A manager confirmed the fix and cleared the flag.
  FLAG_CLEARED
  /// Somebody wrote this person's name into a note.
  MENTIONED

  @@map("notification_kind")
}

/// One thing one person needs to know about.
///
/// Rows rather than a derived query, deliberately. "What needs my attention"
/// cannot be computed from event state alone: a flag raised, seen and moved on
/// from looks identical in the events table to one raised a minute ago, and
/// mentions leave no trace on the event at all. Read state belongs to the
/// person, so it has to be stored per person.
///
/// Never a channel. This is what the bell shows; it does not send email or post
/// to Discord, and nothing here should grow into a delivery mechanism without
/// that being a deliberate decision.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  /// Who is being told.
  recipientId String @map("recipient_id") @db.Uuid
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  /// Who caused it. NULL when the account has since been deleted.
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  kind NotificationKind

  /// The event this is about. Cascades: a notification pointing at a deleted
  /// event is a dead link, not history worth keeping.
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// The flag reason or the note text, captured at the time. Stored rather than
  /// joined because the point of the message is what it said *then* — an edited
  /// note should not silently rewrite the notification that quoted it.
  detail String?

  readAt DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientId, readAt, createdAt(sort: Desc)], map: "notifications_recipient_idx")
  @@index([eventId], map: "notifications_event_idx")
  @@map("notifications")
}

/// "I am working on this right now."
///
/// Heartbeat-driven and expired by the server. Without expiry a closed laptop
/// would leave an event flagged forever and nobody would trust the indicator.
model Presence {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  context PresenceContext

  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeat DateTime @default(now()) @map("last_heartbeat") @db.Timestamptz(6)

  @@unique([userId, eventId, context], map: "presence_user_event_context_key")
  @@index([lastHeartbeat], map: "presence_heartbeat_idx")
  @@index([eventId], map: "presence_event_idx")
  @@map("presence")
}

/// Application settings. A single row, enforced by the `singleton` check.
model Settings {
  id String @id @default("singleton")

  siteName String @default("JPD Group Matrix") @map("site_name")

  /// Business timezone, IANA name. Never an offset.
  timeZone String @default("America/Caracas") @map("time_zone")

  /// Review stage offsets in days, furthest-out first. Configurable.
  reviewOffsets Int[] @default([21, 14, 7, 5, 1]) @map("review_offsets")

  /// Move Saturday/Sunday deadlines back to the preceding Friday.
  weekendAdjustment Boolean @default(true) @map("weekend_adjustment")

  /// Minutes without a heartbeat before an "in progress" flag is dropped.
  presenceTimeoutMinutes Int @default(5) @map("presence_timeout_minutes")

  /// Default theme for users who have not chosen one.
  defaultTheme String @default("light") @map("default_theme")

  /// Clockify workspace to read time entries from. The API key is NOT stored
  /// here — it lives in the CLOCKIFY_API_KEY environment variable so a database
  /// dump never contains a live credential.
  clockifyEnabled     Boolean @default(false) @map("clockify_enabled")
  clockifyWorkspaceId String? @map("clockify_workspace_id")

  /// Payroll identity. Appears on every invoice PDF and remittance email, so
  /// it is configuration rather than something hard-coded in a template.
  businessName    String  @default("JPD Group") @map("business_name")
  businessAddress String? @map("business_address")

  /// Printed at the foot of an invoice — payment terms, tax notes, whatever
  /// this business needs to say on the document.
  invoiceNote String? @map("invoice_note")

  /// Where the payroll run summary goes. The contractor emails go to each
  /// contractor's own address.
  adminRemittanceEmail String? @map("admin_remittance_email")

  /// Sender name on remittance emails. The address itself comes from
  /// RESEND_FROM_EMAIL, which must be on a verified domain.
  remittanceFromName String @default("JPD Group Payroll") @map("remittance_from_name")

  /// How people are actually paid, stated on the invoice and in the email.
  remittancePaymentMethod String @default("USDT") @map("remittance_payment_method")

  remittanceFooterNote String? @map("remittance_footer_note")

  /// Copy every invoice PDF into a Google Drive folder as it is generated.
  /// The service-account key is NOT stored here — it lives in
  /// GOOGLE_SERVICE_ACCOUNT_JSON, same rule as every other credential. The
  /// folder ID is not secret: it is visible in the folder's own URL.
  driveUploadEnabled Boolean @default(false) @map("drive_upload_enabled")
  driveFolderId      String? @map("drive_folder_id")

  /// The Google Sheet that Bulk import can pull rows from, so a schedule kept
  /// in Sheets does not have to be copied and pasted every week.
  ///
  /// Read with the same service account as Drive — the `drive` scope covers the
  /// Sheets API — so there is no second credential, and none of it is stored
  /// here. The spreadsheet ID is not secret: it is the middle of the sheet's
  /// own URL, and the service account still has to be given access to the file
  /// before it can read a single cell.
  ///
  /// `importSheetTab` names which tab to read. NULL means the first one, which
  /// is right for the common case of a single-tab schedule and wrong the moment
  /// somebody adds a "Notes" tab in front of it.
  importSheetId  String? @map("import_sheet_id")
  importSheetTab String? @map("import_sheet_tab")

  /// Phantom Calculator rates, read by the desktop calculator over
  /// `/api/phantom-calculator/rates`.
  ///
  /// Decimal fractions, not percentages: 0.2000 is 20%. Four decimal places
  /// because a rate is a rate — the same reasoning as `hourly_rate` on a
  /// contractor. Rounding 0.0725 to cents before it multiplies a get-in price
  /// would move the answer by real money on an expensive ticket.
  ///
  /// There is no default and never a fallback: these drive purchasing
  /// decisions, so an unset rate must stop the calculator rather than let it
  /// answer with a number nobody chose. A CHECK keeps them in [0, 1).
  phantomTier1Rate   Decimal? @map("phantom_tier_1_rate") @db.Decimal(6, 4)
  phantomStubHubRate Decimal? @map("phantom_stubhub_rate") @db.Decimal(6, 4)

  /// Post releases, payroll runs and Clockify outages to a Discord channel.
  /// The webhook URL is itself the credential and lives in
  /// DISCORD_WEBHOOK_URL.
  discordEnabled Boolean @default(false) @map("discord_enabled")

  /// The newest announcement already posted to Discord. This is what makes
  /// release notification idempotent: the hourly run posts what has appeared
  /// since, so a restart, a redeploy or two instances racing cannot announce
  /// the same release twice.
  discordLastReleaseId String? @map("discord_last_release_id")

  /// Last known Clockify reachability. NULL until first probed. Kept so that
  /// only *changes* are announced — repeating "still down" hourly is how a
  /// channel gets muted.
  clockifyHealthy         Boolean?  @map("clockify_healthy")
  clockifyHealthCheckedAt DateTime? @map("clockify_health_checked_at") @db.Timestamptz(6)

  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("settings")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// NULL when the actor is the system (scheduled maintenance).
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Set when the action was taken while impersonating someone. The acting
  /// administrator stays in `user_id`, so "who really did this" is never lost.
  impersonatedUserId String? @map("impersonated_user_id") @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid
  action     String

  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_logs_entity_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Payroll
 */
/**
 * --------------------------------------------------------------------------
 */

enum PayType {
  /// Paid a fixed amount per week. Hours are recorded but do not drive pay.
  FLAT_WEEKLY
  /// Paid per approved hour.
  HOURLY

  @@map("pay_type")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW

  @@map("approval_status")
}

enum InvoiceStatus {
  GENERATED
  SENT
  PAID
  VOID

  @@map("invoice_status")
}

/// Where an invoice came from.
enum InvoiceKind {
  /// Generated from an approved week of hours. The normal path.
  PAYROLL
  /// Entered by hand — a bonus, a reimbursement, anything not driven by hours.
  /// Carries a description instead of a pay type, and is exempt from the
  /// one-live-invoice-per-week rule, since a bonus is paid alongside the wage
  /// it accompanies rather than instead of it.
  MANUAL

  @@map("invoice_kind")
}

/// A person paid through payroll. Deliberately separate from `User`: someone
/// can be paid without having a login, and can have a login without being paid.
/// `userId` links the two where they happen to be the same person.
model Contractor {
  id   String @id @default(uuid()) @db.Uuid
  name String

  /// Whose time to import. Null means they are paid without tracked time.
  clockifyUserId String? @unique @map("clockify_user_id")

  payType PayType @map("pay_type")

  /// Only meaningful for FLAT_WEEKLY; a CHECK constraint enforces that the one
  /// matching this pay type is present.
  weeklyAmount Decimal? @map("weekly_amount") @db.Decimal(12, 2)

  /// Four decimal places: an hourly rate is a rate, not a money amount, and
  /// rounding it to cents before multiplying loses real money over a week.
  hourlyRate Decimal? @map("hourly_rate") @db.Decimal(12, 4)

  /// Leading part of every invoice number for this person, e.g. "NAT".
  invoicePrefix String @unique @map("invoice_prefix")

  active            Boolean @default(true)
  remittanceEmail   String? @map("remittance_email")
  discordWebhookUrl String? @map("discord_webhook_url")
  notes             String?

  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation("ContractorUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  timeEntries ImportedTimeEntry[]
  approvals   WeeklyApproval[]
  invoices    Invoice[]

  @@index([active, name])
  @@map("contractors")
}

/// One Sunday-to-Saturday pay week.
model PayrollPeriod {
  id String @id @default(uuid()) @db.Uuid

  /// Sunday. DATE, never a timestamp — a pay week is a calendar fact.
  periodStart DateTime @unique @map("period_start") @db.Date
  /// Saturday.
  periodEnd   DateTime @map("period_end") @db.Date

  /// The Friday after `periodEnd`. Stored rather than derived, so a historical
  /// record keeps the date people were actually told.
  depositDate DateTime @map("deposit_date") @db.Date

  /// Set when payroll for the week is finished; blocks further import.
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  timeEntries ImportedTimeEntry[]
  approvals   WeeklyApproval[]
  invoices    Invoice[]

  @@index([periodStart(sort: Desc)])
  @@map("payroll_periods")
}

/// A raw Clockify entry, kept verbatim for audit. Never edited.
model ImportedTimeEntry {
  id String @id @default(uuid()) @db.Uuid

  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  /// Clockify's own id. Unique, which is what makes re-importing idempotent
  /// without the application having to reason about it.
  clockifyEntryId String @unique @map("clockify_entry_id")
  clockifyUserId  String @map("clockify_user_id")

  startTime DateTime @map("start_time") @db.Timestamptz(6)
  endTime   DateTime @map("end_time") @db.Timestamptz(6)

  /// Whole seconds, not fractional hours. Hours are a presentation of this;
  /// storing them as a float would accumulate error across a week of entries.
  durationSeconds Int @map("duration_seconds")

  description String?

  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([payrollPeriodId, contractorId])
  @@map("imported_time_entries")
}

/// One row per contractor per pay week: what they are owed, and whether a
/// manager has signed it off.
///
/// Pay type and rates are snapshotted here rather than read live from the
/// contractor. Changing someone's rate must not silently restate a week that
/// has already been approved or paid.
model WeeklyApproval {
  id String @id @default(uuid()) @db.Uuid

  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  payType         PayType  @map("pay_type")
  clockifySeconds Int      @default(0) @map("clockify_seconds")
  weeklyAmount    Decimal? @map("weekly_amount") @db.Decimal(12, 2)
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(12, 4)

  /// What this person is owed for the week, already rounded to cents.
  invoiceAmount Decimal @map("invoice_amount") @db.Decimal(12, 2)

  managerStatus ApprovalStatus @default(PENDING) @map("manager_status")

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedBy   User?     @relation("ApprovalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)

  /// Manager's note, e.g. why a row was rejected.
  reviewNote String? @map("review_note")

  invoiceId String?  @unique @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([payrollPeriodId, contractorId])
  @@index([payrollPeriodId, managerStatus])
  @@map("weekly_approvals")
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  /// `PREFIX-YYYYMMDD`. Unique, so a duplicate is refused by the database
  /// rather than by a check the application might forget to make.
  invoiceNumber String @unique @map("invoice_number")

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)

  kind InvoiceKind @default(PAYROLL)

  /// What a manual invoice is for — "Q3 bonus", "Equipment reimbursement".
  /// Printed as the line item in place of the pay type. Required on a MANUAL
  /// invoice and absent on a PAYROLL one; the database enforces both.
  description String?

  /// Snapshots, as on the approval row.
  ///
  /// Null on a manual invoice: a bonus has no pay type, and storing one would
  /// put a figure on the document that nothing derived it from.
  payType         PayType? @map("pay_type")
  approvedSeconds Int      @default(0) @map("approved_seconds")
  weeklyAmount    Decimal? @map("weekly_amount") @db.Decimal(12, 2)
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(12, 4)

  amount Decimal @db.Decimal(12, 2)

  pdfUrl      String? @map("pdf_url")
  documentUrl String? @map("document_url")

  /// Copy in Google Drive, when that is switched on. Nullable throughout:
  /// Drive being unreachable must never stop an invoice being generated or
  /// emailed, so the upload is a follow-on that can be retried, not a step the
  /// invoice depends on.
  driveFileId     String?   @map("drive_file_id")
  driveWebLink    String?   @map("drive_web_link")
  driveUploadedAt DateTime? @map("drive_uploaded_at") @db.Timestamptz(6)
  /// Why the last upload attempt failed, for the administrator to act on.
  driveError      String?   @map("drive_error")

  status InvoiceStatus @default(GENERATED)

  paymentDate DateTime? @map("payment_date") @db.Date
  usdtTxHash  String?   @map("usdt_tx_hash")

  depositDate DateTime @map("deposit_date") @db.Date
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason String?   @map("void_reason")

  remittanceSent      Boolean   @default(false) @map("remittance_sent")
  remittanceSentAt    DateTime? @map("remittance_sent_at") @db.Timestamptz(6)
  remittanceError     String?   @map("remittance_error")
  lastRemittanceCheck DateTime? @map("last_remittance_check") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  approval WeeklyApproval?

  @@index([payrollPeriodId, status])
  @@index([contractorId, generatedAt(sort: Desc)])
  @@map("invoices")
}

/// One browser's permission to send this person notifications.
///
/// A row per *device*, not per person: somebody with a phone and a desktop has
/// two, and revoking one must not silence the other. The endpoint is the
/// identity — push services issue a new one rather than updating an old one,
/// so re-subscribing on the same device creates a row and the stale one is
/// pruned when it starts failing.
model PushSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service URL. Unique because it *is* the subscription.
  endpoint String @unique

  /// The keys the payload is encrypted to. Useless without them — a push
  /// service only relays ciphertext it cannot read.
  p256dh String
  auth   String

  /// Which browser this came from, so a stale device is recognisable in the
  /// list somebody is asked to prune.
  userAgent String? @map("user_agent")

  /// Consecutive send failures. A push service answering 404 or 410 means the
  /// subscription is dead and the row is deleted outright; this counts the
  /// softer failures, so a device that has been unreachable for a long run can
  /// be retired without deleting one that had a single bad night.
  failureCount Int @default(0) @map("failure_count")

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_subscriptions")
}

/// The last clock state we told anybody about.
///
/// Clocking in happens in Clockify, not here, so a transition can only be
/// noticed by comparing a poll against what was true last time. Without this
/// row there is nothing to compare to, and every poll would either announce
/// everybody who is currently on the clock or announce nothing at all.
model ClockStatus {
  userId String @id @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Whether they were on the clock at `checkedAt`.
  running Boolean @default(false)

  /// When the running entry started, straight from Clockify. Used to catch a
  /// clock-out-and-straight-back-in between two polls, which leaves `running`
  /// true at both ends and would otherwise pass unnoticed.
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)

  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("clock_status")
}

/// A short, renewable claim on a job only one process may run.
///
/// The clock poller runs inside the web server rather than as its own service.
/// That is simple and right for one instance, and silently wrong the moment
/// there are two: both would poll, both would see the same transition, and
/// everybody would get every notification twice. Whoever holds the lease polls;
/// everybody else skips the tick. An expiry rather than a release flag, so a
/// process that dies mid-tick does not hold the job shut forever.
model SystemLease {
  name      String   @id
  holder    String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("system_leases")
}
